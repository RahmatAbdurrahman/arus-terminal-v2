# Salin ke .env.local, isi nilai aslinya. .env.local sudah di .gitignore — JANGAN commit.

# Supabase — project "arus-terminal", region ap-southeast-1
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role melewati RLS — server saja, JANGAN pakai awalan NEXT_PUBLIC_,
# ambil dari Supabase Dashboard > Project Settings > API (nggak bisa diambil lewat tool)
SUPABASE_SERVICE_ROLE_KEY=

# Sectors API — dari klaim kredit tim hackathon
SECTORS_API_KEY=

# Endpoint cron ingest (/api/cron/ingest) menolak request tanpa header ini
# Vercel Cron otomatis mengirim "Authorization: Bearer <CRON_SECRET>" kalau
# ini di-set sebagai env var project.
CRON_SECRET=

# Fitur AI (Could) — cuma dibutuhkan kalau tombol "jelaskan"/"Tanya ARUS" dikerjakan
GEMINI_API_KEY=

# Fitur Telegram opsional (Could) — cuma kalau notifikasi daftar pendek dikerjakan
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_CHAT_ID=
